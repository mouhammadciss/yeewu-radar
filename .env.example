# Mot de passe de l'espace /admin
ADMIN_PASSWORD=change-moi
# Secret du cron Vercel (chaîne longue au hasard)
CRON_SECRET=change-moi-aussi
# Optionnel : tonalité par Claude (sinon lexique FR/wolof)
ANTHROPIC_API_KEY=
